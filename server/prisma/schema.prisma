// This is your Prisma schema file.
// Datasource uses SQLite for development. Switch provider to "postgresql"
// and update DATABASE_URL in .env for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Note: SQLite does not support native enums. Role and OrderStatus are stored
// as plain String fields. Valid values are enforced at the application layer.
// Valid Role values:        CUSTOMER | ADMIN
// Valid OrderStatus values: PENDING | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
// ─────────────────────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("CUSTOMER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders         Order[]
  addresses      Address[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  reviews        Review[]
  userCrates     UserCrate[]
  inventoryItems InventoryItem[]
  shardMerges    ShardMerge[]
  marketListings MarketListing[]
  marketOffers   MarketOffer[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth tokens
// ─────────────────────────────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  stripeSessionId String?     @unique
  printifyOrderId String?
  status          String      @default("PENDING")
  total           Float
  shippingName    String
  shippingLine1   String
  shippingLine2   String?
  shippingCity    String
  shippingState   String
  shippingZip     String
  shippingCountry String      @default("US")
  email           String
  trackingNumber  String?
  trackingUrl     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  variantId   String?
  name        String
  price       Float
  qty         Int
  image       String?
  placement   String  @default("left")
}

// ─────────────────────────────────────────────────────────────────────────────
// Addresses
// ─────────────────────────────────────────────────────────────────────────────

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  country   String  @default("US")
  isDefault Boolean @default(false)
}

// ─────────────────────────────────────────────────────────────────────────────
// Shop Products
// Stores the storefront catalog. Each product has three placement variants
// (left / center / right) each pointing to a separate Printify product.
// ─────────────────────────────────────────────────────────────────────────────

model Collection {
  slug String @id
  name String
}

model ShopProduct {
  id          String   @id            // human slug, e.g. "gc01"
  pname       String
  price       Float
  rating      Float    @default(0)
  collection  String                  // "bp" | "fame" | "stem"
  description String   @default("")
  published     Boolean  @default(true)
  featured      Boolean  @default(false)
  sortOrder     Int      @default(0)
  featuredOrder Int      @default(0)

  // Left placement
  imageLeft        String  @default("")
  printifyIdLeft   String  @default("")
  variantIdLeft    String  @default("")

  // Center placement
  imageCenter      String  @default("")
  printifyIdCenter String  @default("")
  variantIdCenter  String  @default("")

  // Right placement
  imageRight       String  @default("")
  printifyIdRight  String  @default("")
  variantIdRight   String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews Review[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Newsletter subscribers
// ─────────────────────────────────────────────────────────────────────────────

model Subscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  subscribedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews
// One review per user per product. Rating is 1–5 (integer).
// ShopProduct.rating caches the rolling average for fast reads.
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  body      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId],    references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Page view tracking
// ─────────────────────────────────────────────────────────────────────────────

model PageView {
  id        String   @id @default(cuid())
  path      String
  ip        String   @default("")
  userAgent String   @default("")
  sessionId String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
  @@index([sessionId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Crates (loot-box system)
// ─────────────────────────────────────────────────────────────────────────────

// A crate type that users can purchase as a key.
model Crate {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  image       String   @default("")
  price       Float    // price in dollars
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prizes     CratePrize[]
  userCrates UserCrate[]
}

// A possible prize inside a crate.
model CratePrize {
  id              String @id @default(cuid())
  crateId         String
  crate           Crate  @relation(fields: [crateId], references: [id], onDelete: Cascade)
  productId       String // ShopProduct.id
  discountedPrice Float  // winning price in dollars
  weight          Int    @default(100) // relative probability weight
  rarity          String @default("common") // "common" | "uncommon" | "rare" | "legendary"
  itemType        String @default("SHARD")  // SHARD | WILDCARD_SHARD | DISCOUNT_VOUCHER | MUG_VOUCHER | DORK_COIN
  itemValue       Float  @default(0)        // DISCOUNT_VOUCHER: percent off. Otherwise 0.
  coinAmount      Int    @default(0)        // bonus coins dropped alongside any item type
  createdAt       DateTime @default(now())
}

// A single crate key owned by a user (one row per key purchased).
model UserCrate {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  crateId         String
  crate           Crate     @relation(fields: [crateId], references: [id], onDelete: Restrict)
  stripeSessionId String?
  opened          Boolean   @default(false)
  openedAt        DateTime?
  createdAt       DateTime  @default(now())

  opening CrateOpening?
}

// ─────────────────────────────────────────────────────────────────────────────
// Peer-to-peer Market
// Users can list items for sale. Status: ACTIVE | SOLD | REMOVED
// ─────────────────────────────────────────────────────────────────────────────

model MarketListing {
  id          String   @id @default(cuid())
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  price       Float
  condition   String   @default("used")   // "new" | "like-new" | "used" | "for-parts"
  category    String   @default("other")  // "mugs" | "accessories" | "art" | "other"
  imageUrl    String   @default("")
  status      String   @default("ACTIVE") // "ACTIVE" | "SOLD" | "REMOVED"

  // Source inventory linkage (populated when seller picks from their inventory)
  sourceType            String  @default("MANUAL") // "MANUAL" | "INVENTORY_ITEM" | "CRATE_KEY"
  sourceInventoryItemId String? // InventoryItem.id
  sourceUserCrateId     String? // UserCrate.id

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offers MarketOffer[]
}

// Buyer expresses interest / makes an offer on a listing.
model MarketOffer {
  id        String        @id @default(cuid())
  listingId String
  listing   MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  message   String        @default("")
  status    String        @default("PENDING") // "PENDING" | "ACCEPTED" | "DECLINED"
  createdAt DateTime      @default(now())

  @@unique([listingId, buyerId])
}

// Record of a crate being opened and the prize won.
model CrateOpening {
  id          String    @id @default(cuid())
  userCrateId String    @unique
  userCrate   UserCrate @relation(fields: [userCrateId], references: [id], onDelete: Cascade)
  userId      String
  prizeId     String
  productId   String    // ShopProduct.id that was won
  wonPrice    Float     // discounted price in dollars
  claimToken  String    @unique @default(cuid())
  claimed     Boolean   @default(false)
  claimedAt   DateTime?
  itemType    String    @default("SHARD") // item type awarded
  itemQuantity Int      @default(1)
  createdAt   DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventory
// Stores all items a user owns: shards, wildcards, vouchers, coins, ownership tokens.
// type values: SHARD | WILDCARD_SHARD | DISCOUNT_VOUCHER | MUG_VOUCHER | DORK_COIN | OWNERSHIP_TOKEN
// ─────────────────────────────────────────────────────────────────────────────
model InventoryItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String    // SHARD | WILDCARD_SHARD | DISCOUNT_VOUCHER | MUG_VOUCHER | DORK_COIN | OWNERSHIP_TOKEN
  productId   String?   // mug design this item is tied to (null for coins/wildcards)
  quantity    Int       @default(1)
  value       Float?    // DORK_COIN: coin amount. DISCOUNT_VOUCHER: percent off (e.g. 15)
  redeemed    Boolean   @default(false)
  redeemedAt  DateTime?
  source      String    @default("CRATE") // CRATE | MERGE | ADMIN
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([userId, type])
  @@index([userId, productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Shard merges
// Records every time a user burns 10 shards into a mug voucher.
// ─────────────────────────────────────────────────────────────────────────────
model ShardMerge {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId     String
  shardsUsed    Int      @default(10)
  wildcardCount Int      @default(0)
  voucherItemId String   @unique
  createdAt     DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Ownership Token Transfers
// Created when a market sale of an OWNERSHIP_TOKEN is accepted.
// Tracks the physical re-ship logistics chain.
// ─────────────────────────────────────────────────────────────────────────────
model TransferRequest {
  id               String   @id @default(cuid())
  inventoryItemId  String   // InventoryItem being transferred
  fromUserId       String   // seller
  toUserId         String   // buyer
  marketListingId  String   // the MarketListing that triggered this
  status           String   @default("PENDING_RETURN")
  // PENDING_RETURN   — waiting for seller to ship mug back to Dork Mugs
  // MUG_RECEIVED     — Dork Mugs received the mug
  // RESHIPPING       — Dork Mugs is shipping to new owner
  // COMPLETED        — new owner received mug, token transferred
  // CANCELLED        — transfer cancelled
  sellerTrackingNumber   String?  // seller → Dork Mugs tracking
  dorkmugsTrackingNumber String?  // Dork Mugs → buyer tracking
  notes            String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
}